+                                        double startLat,
+                                        double startLng,
+                                        double endLat,
+                                        double endLng,
+                                        int steps) {
+        for (int i = 0; i <= steps; i += 1) {
+            if (!points.isEmpty() && i == 0) {
+                continue;
+            }
+            double pct = i / (double) steps;
+            points.add(new double[]{
+                    startLat + (endLat - startLat) * pct,
+                    startLng + (endLng - startLng) * pct
+            });
+        }
+    }
