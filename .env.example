# Hermes Environment Variables
# Copy this file to .env and fill in the values you need.
# Lines starting with # are comments. Blank lines are ignored.
#
# Tag guide:
#   [REQUIRED] -- Hermes wont function correctly without this for the listed feature.
#   [OPTIONAL] -- Sensible default in application.properties; override only when needed.
#   [SECRET]   -- Treat as a secret; never commit to version control.
#
# Last updated: 2026-04-30 -- synced from backend/src/main/resources/application.properties

# --- Deployment mode --------------------------------------------------
# Set to production on public servers (enforces stricter Strava webhook
# validation when Strava is enabled, disables local shared runner bootstrap).
# [REQUIRED for production] Default: development
HERMES_ENV=development

# --- HTTPS and CORS ---------------------------------------------------
# Force HTTPS redirect at the app layer (safe behind reverse proxy).
# [OPTIONAL] Default: false
APP_FORCE_HTTPS=false

# Enable HTTP Strict Transport Security header.
# Set true only when the site is served over HTTPS everywhere.
# [OPTIONAL] Default: true
APP_ENABLE_HSTS=true

# Comma-separated CORS origins when React is not served from the same host.
# [OPTIONAL] Default: (empty -- same-origin only)
APP_CORS_ALLOWED_ORIGINS=

# --- Database ---------------------------------------------------------
# Default: local file-backed H2. For PostgreSQL, set all four vars
# and APP_DB_DRIVER=org.postgresql.Driver.
# [OPTIONAL for H2] [REQUIRED for PostgreSQL]
APP_DB_URL=jdbc:h2:file:./hermes_db_v2;AUTO_SERVER=TRUE
APP_DB_DRIVER=org.h2.Driver
APP_DB_USERNAME=sa
APP_DB_PASSWORD=

# JPA schema strategy. update for dev; validate for production.
# [OPTIONAL] Default: update
APP_JPA_DDL_AUTO=update

# --- Redis (optional performance layer) -------------------------------
# Keep disabled for local single-instance runs.
# [OPTIONAL] Default: false
APP_REDIS_ENABLED=false
APP_REDIS_KEY_PREFIX=hermes
APP_REDIS_HOST=localhost
APP_REDIS_PORT=6379
APP_REDIS_PASSWORD=
APP_REDIS_DATABASE=0

# --- Google OAuth 2.0 -------------------------------------------------
# [REQUIRED for Google sign-in] [SECRET]
APP_GOOGLE_CLIENT_ID=
APP_GOOGLE_CLIENT_SECRET=

# Legacy fallback aliases (checked after APP_GOOGLE_*):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Redirect URI overrides [OPTIONAL]:
# APP_GOOGLE_REDIRECT_URI=
# GOOGLE_REDIRECT_URI=

# --- Strava OAuth 2.0 -------------------------------------------------
# [REQUIRED for Strava sign-in and activity sync] [SECRET]
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Fallback aliases (checked after STRAVA_*):
# APP_STRAVA_CLIENT_ID=
# APP_STRAVA_CLIENT_SECRET=

# Redirect URI overrides [OPTIONAL]:
# STRAVA_REDIRECT_URI=
# APP_STRAVA_REDIRECT_URI=

# Encryption key for stored Strava refresh tokens.
# [REQUIRED for Strava token storage] [SECRET]
APP_DATA_ENCRYPTION_KEY=

# Strava webhook verify token. Set the same value when creating
# the subscription via Strava API.
# [REQUIRED for production webhook] [SECRET]
STRAVA_WEBHOOK_VERIFY_TOKEN=

# Polling interval for background Strava sync (ms).
# [OPTIONAL] Default: 600000 (10 min)
STRAVA_SYNC_INTERVAL_MS=600000

# --- Garmin Wellness Sync ---------------------------------------------
# Background import of sleep, HRV, resting HR, stress, body battery.
# Uses garmindb Python tooling.
# [OPTIONAL] Default: true
GARMIN_WELLNESS_SYNC_ENABLED=true
GARMIN_WELLNESS_SYNC_INTERVAL_MS=1800000
GARMIN_WELLNESS_SYNC_DAYS_BACK=30
GARMIN_WELLNESS_SYNC_INITIAL_DAYS_BACK=90

# --- AI Vision (shoe image scanning) ----------------------------------
# API key for Gemini vision provider.
# [REQUIRED for AI shoe scan] [SECRET]
APP_AI_API_KEY=

# [OPTIONAL] Model and provider defaults:
APP_AI_MODEL=gemini-2.5-flash
APP_AI_PROVIDER=gemini

# Course-map PDF alignment provider.
# [OPTIONAL] Default: qwen-local
APP_AI_COURSE_MAP_PROVIDER=qwen-local
APP_AI_COURSE_MAP_PDF_RENDER_PAGE_LIMIT=2

# Free-tier AI rate limits.
APP_AI_FREE_TIER_PER_RUNNER_DAILY_LIMIT=5
APP_AI_FREE_TIER_PROJECT_DAILY_LIMIT=200
APP_AI_FREE_TIER_PROJECT_DAILY_RESERVE=20

# --- Marathon Route Extraction (Qwen + Python/OpenCV) -----------------
# Step 1 uses local Qwen structured JSON output for course-map alignment.
# Step 2 shells out to a local Python/OpenCV worker for route extraction.
# All variables below are [OPTIONAL] with sensible defaults for dev.

APP_ROUTE_EXTRACTION_PYTHON_COMMAND=python
# APP_ROUTE_EXTRACTION_PYTHON_SCRIPT=
# APP_ROUTE_EXTRACTION_QWEN_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
# APP_ROUTE_EXTRACTION_QWEN_DEVICE_MAP=auto
# APP_ROUTE_EXTRACTION_QWEN_CACHE_DIR=
# APP_ROUTE_EXTRACTION_QWEN_PERSISTENT_WORKER_ENABLED=true
# APP_ROUTE_EXTRACTION_QWEN_WORKER_SCRIPT=
# APP_ROUTE_EXTRACTION_QWEN_TIMEOUT_SECONDS=300
# APP_ROUTE_EXTRACTION_QWEN_ALIGNMENT_TIMEOUT_SECONDS=720
# APP_ROUTE_EXTRACTION_QWEN_PARAMETERS_SCRIPT=
# APP_ROUTE_EXTRACTION_QWEN_ANCHOR_SCRIPT=
# APP_ROUTE_EXTRACTION_QWEN_ALIGNMENT_SCRIPT=

# OSRM routing engine for route map matching.
# [OPTIONAL] Default: https://router.project-osrm.org
# APP_ROUTE_MATCHING_OSRM_BASE_URL=https://router.project-osrm.org
# APP_ROUTE_MATCHING_OSRM_PROFILE=driving

# --- Stripe Checkout (Pro subscription) -------------------------------
# Create a Price in Stripe Dashboard and paste its price_xxx id here.
# Webhook endpoint: POST /api/billing/webhook
# [REQUIRED for Stripe billing] [SECRET]
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=

# Public-facing base URL used in Stripe redirect URLs.
# [REQUIRED for production] Default: http://localhost:8080
APP_PUBLIC_BASE_URL=http://localhost:8080

# Display label shown in Profile UI (e.g. USD 9/month).
# [OPTIONAL] Default: (empty -- not shown)
APP_BILLING_PRICE_LABEL=

# --- Email (verification and password reset) --------------------------
# If SPRING_MAIL_HOST is empty, new accounts skip inbox verification
# (development mode only).
# [REQUIRED for email] [SECRET]
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# From address for outgoing mail.
# [OPTIONAL] Default: noreply@localhost
APP_MAIL_FROM=noreply@localhost

# --- Local Shared Runner (contributor demos) --------------------------
# Seeds a shared demo account with shoes and mock activities.
# Disabled by default; skipped when HERMES_ENV=production.
# [OPTIONAL] Default: false
APP_LOCAL_SHARED_RUNNER_ENABLED=false
# APP_LOCAL_SHARED_RUNNER_EMAIL=strava+140971747@hermes.local
# APP_LOCAL_SHARED_RUNNER_PASSWORD=
# APP_LOCAL_SHARED_RUNNER_STRAVA_ATHLETE_ID=140971747
# APP_LOCAL_SHARED_RUNNER_DISPLAY_NAME=Hermes Shared Runner
# APP_LOCAL_SHARED_RUNNER_SEED_MOCK_DATA=true

# --- Tooling / automation ---------------------------------------------
# True-stop notification emails from the auto-hermes loop engine.
# AUTO_HERMES_NOTIFY_ENABLED=false
# AUTO_HERMES_NOTIFY_TO=

# Override local auto-hermes executor commands (Claude Code / Codex CLI).
# AUTO_HERMES_EXECUTOR_COMMAND=
# AUTO_HERMES_MAX_EXECUTOR_COMMAND=

# Base URL and admin token for shoe catalog import tooling.
# HERMES_API_BASE=http://localhost:8080
# HERMES_ADMIN_TOKEN=
