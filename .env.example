# Hermes — Example Environment File
#
# Copy this to .env (gitignored) and fill in the values you need.
# On Windows, prefer Hermes.local.env.ps1 — the existing PowerShell
# launcher script forwards APP_* values into the backend window.
#
# Most variables can be empty in development — the backend falls back
# to safe defaults. The "Production hardening" section is only needed
# when HERMES_ENV=production.

# ─ Database (PostgreSQL prod; H2 default in dev) ──────────────────────────────
APP_DB_URL=                     # jdbc:postgresql://localhost:5432/hermes
APP_DB_USERNAME=                # H2 default: sa
APP_DB_PASSWORD=
APP_DB_DRIVER=                  # org.postgresql.Driver (leave blank to use H2)
APP_JPA_DDL_AUTO=update         # validate in production with migrations

# ─ Strava OAuth (login + activity sync) ────────────────────────────────────────
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=            # default: http://localhost:8080/api/auth/strava/callback
APP_DATA_ENCRYPTION_KEY=        # long random hex; encrypts stored Strava tokens (openssl rand -hex 32)
STRAVA_SYNC_INTERVAL_MS=600000  # background pull interval in ms (default: 10 min)
STRAVA_WEBHOOK_VERIFY_TOKEN=    # required when HERMES_ENV=production

# ─ Google OAuth (login) ────────────────────────────────────────────────────────
APP_GOOGLE_CLIENT_ID=
APP_GOOGLE_CLIENT_SECRET=
APP_GOOGLE_REDIRECT_URI=        # default: http://localhost:8080/api/auth/google/callback
APP_GOOGLE_GEOCODING_API_KEY=   # optional; georeferencing for marathon course maps

# ─ Admin bootstrap (created on first startup) ──────────────────────────────────
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# ─ Stripe billing (optional Pro tier) ──────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_MONTHLY=       # price_xxx from Stripe Dashboard
STRIPE_WEBHOOK_SECRET=          # whsec_xxx — signing secret for POST /api/billing/webhook
APP_PUBLIC_BASE_URL=            # default: http://localhost:8080; used in Stripe redirect URLs
APP_BILLING_PRICE_LABEL=        # display label shown in UI, e.g. $9/month or ¥68/月

# ─ Email verification (SMTP) — leave SPRING_MAIL_HOST empty to skip ───────────
SPRING_MAIL_HOST=               # e.g. smtp.gmail.com; empty disables inbox verification (dev only)
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_FROM=                  # default: noreply@localhost

# ─ Garmin wellness sync (sleep, HRV, stress, body battery) ────────────────────
GARMIN_WELLNESS_SYNC_ENABLED=true
GARMIN_WELLNESS_SYNC_INTERVAL_MS=1800000  # 30 min
GARMIN_WELLNESS_SYNC_DAYS_BACK=30
GARMIN_WELLNESS_SYNC_INITIAL_DAYS_BACK=90

# ─ AI keys ─────────────────────────────────────────────────────────────────────
APP_AI_API_KEY=                 # Gemini 2.5 Flash — shoe image scanning + cloud course-map analysis
APP_AI_MODEL=gemini-2.5-flash
APP_AI_PROVIDER=gemini
APP_AI_COURSE_MAP_PROVIDER=qwen-local  # qwen-local (no key needed) or gemini
APP_AI_COURSE_MAP_PDF_RENDER_PAGE_LIMIT=2
APP_AI_FREE_TIER_PER_RUNNER_DAILY_LIMIT=5
APP_AI_FREE_TIER_PROJECT_DAILY_LIMIT=200
APP_AI_FREE_TIER_PROJECT_DAILY_RESERVE=20

# ─ Marathon route extraction (Python + Qwen local pipeline) ────────────────────
APP_ROUTE_EXTRACTION_PYTHON_COMMAND=python
APP_ROUTE_EXTRACTION_PYTHON_SCRIPT=              # path to main extraction script; optional
APP_ROUTE_EXTRACTION_QWEN_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
APP_ROUTE_EXTRACTION_QWEN_DEVICE_MAP=auto        # auto, cuda:0, cpu, etc.
APP_ROUTE_EXTRACTION_QWEN_CACHE_DIR=             # local cache dir for model weights
APP_ROUTE_EXTRACTION_QWEN_TIMEOUT_SECONDS=300
APP_ROUTE_EXTRACTION_QWEN_ALIGNMENT_TIMEOUT_SECONDS=720
APP_ROUTE_EXTRACTION_QWEN_PARAMETERS_SCRIPT=     # optional custom sub-step scripts
APP_ROUTE_EXTRACTION_QWEN_ANCHOR_SCRIPT=
APP_ROUTE_EXTRACTION_QWEN_ALIGNMENT_SCRIPT=

# ─ OSRM map matching ───────────────────────────────────────────────────────────
APP_ROUTE_MATCHING_OSRM_BASE_URL=https://router.project-osrm.org
APP_ROUTE_MATCHING_OSRM_PROFILE=driving          # driving | foot | bike

# ─ CDN (digital cosmetics / badge animations) ─────────────────────────────────
APP_CDN_BASE_URL=               # default: https://cdn.hermes.app/cosmetics

# ─ Production hardening ────────────────────────────────────────────────────────
HERMES_ENV=                     # set "production" to enforce stricter checks
APP_FORCE_HTTPS=false           # set true only behind a TLS-terminating reverse proxy
APP_ENABLE_HSTS=false           # set true only when ALL traffic is HTTPS
APP_CORS_ALLOWED_ORIGINS=       # comma-separated origins when API and SPA are on different hosts
